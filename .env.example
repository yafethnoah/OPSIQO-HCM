# Server
# Firebase Admin auth: service_account (explicit key injection) or adc (recommended for managed workloads/WIF).
OPSIQO_FIREBASE_ADMIN_AUTH_MODE=adc
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
OPSIQO_DEMO_MODE=false
OPSIQO_DEMO_ORG_ID=
OPSIQO_DEMO_UID=

# Client
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_OPSIQO_DEMO_MODE=false
NEXT_PUBLIC_OPSIQO_ORG_ID=demo-org
NEXT_PUBLIC_OPSIQO_DEMO_ORG_ID=

# Optional local Firebase Emulator Suite
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Invitation delivery (optional; manual secure link is returned when omitted)
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000
RESEND_API_KEY=
INVITATION_FROM_EMAIL="OPSIQO HCM <noreply@example.com>"
NOTIFICATION_FROM_EMAIL="OPSIQO HCM <noreply@example.com>"
OPSIQO_DEMO_WORKER_ID=worker-001

# Phase 1 automation jobs
# Use a long random value and send it as x-opsiqo-job-secret to POST /api/internal/automation.
OPSIQO_JOB_SECRET=
OPSIQO_JOB_ORG_ID=
OPSIQO_AUTOMATION_SCOPE=organization

# Enterprise security hardening (production)
# Enforce Firebase App Check on authenticated APIs. Configure the matching web site key below.
OPSIQO_REQUIRE_APP_CHECK=false
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
# Require a verified second factor for super_admin, org_admin and hr_admin.
OPSIQO_REQUIRE_ADMIN_MFA=false
# Optional comma-separated Firebase sign-in provider allow-list for privileged roles.
# Examples depend on your configured Firebase Authentication / Identity Platform providers.
OPSIQO_ALLOWED_ADMIN_PROVIDERS=

# Multi-organization platform control plane.
# Comma-separated exact email identities allowed to administer OPSIQO tenants at platform scope.
# This is separate from organization-admin permissions. Prefer the platformAdministrators registry after bootstrap.
OPSIQO_PLATFORM_ADMIN_EMAILS=
# Platform administration requires a verified second factor by default. Keep true in UAT/production.
OPSIQO_REQUIRE_PLATFORM_ADMIN_MFA=true
# Local emulator only. Never enable in UAT/production.
OPSIQO_LOCAL_PLATFORM_ADMIN=false

# Phase 2 secure onboarding documents
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
# Legacy Firebase projects created before September 2024 may use your-project-id.appspot.com
ONBOARDING_FROM_EMAIL="OPSIQO HCM <noreply@example.com>"

# Block governed-document downloads in production until scanStatus=clean.
OPSIQO_REQUIRE_CLEAN_DOCUMENT_SCAN=true

# Employee Relations v1.5
# No AI disciplinary/finding automation is enabled. Configure ER retention/legal-hold policies before production use.

# Dedicated HMAC secret for anonymous survey participation indexes (32+ random characters in production)
OPSIQO_SURVEY_ANONYMITY_SECRET=

# Phase 4 v2.0 AI Intelligence
OPSIQO_AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# AI remote-provider calls are server-only. OpenAI adapter explicitly uses store=false.
OPSIQO_AI_MAX_EVIDENCE_ITEMS=18
OPSIQO_REQUIRE_GOVERNED_AI_CONFIG=false

# Phase 4 v2.1 HR Diagnostic
OPSIQO_DIAGNOSTIC_DEFAULT_REVIEW_DAYS=365

# Phase 4 v2.4 policy + regulatory change / release metadata
OPSIQO_RELEASE_VERSION=3.6.1
# Optional deployment metadata for logs/observability. Do not put secrets here.
OPSIQO_RELEASE_COMMIT=

# Phase 4 v2.4 regulatory source egress allow-list (required in production)
# Exact public hostnames only, comma-separated. Example: www.ontario.ca,ontario.ca,payequity.gov.on.ca
OPSIQO_REGULATORY_SOURCE_HOSTS=

# v3.2 Enterprise Integration Runtime & Data Exchange
# External connectors are disabled unless explicitly enabled. Production readiness then requires an exact public-host allow-list.
OPSIQO_ENABLE_EXTERNAL_INTEGRATIONS=false
OPSIQO_INTEGRATION_HOSTS=

# v3.2 signed-webhook runtime
# Maximum raw inbound webhook body accepted before HMAC/contract processing (default 1 MiB).
OPSIQO_WEBHOOK_MAX_BODY_BYTES=1048576
# Built-in runtime secret resolution supports env://NAME references. Other secret-provider reference schemes remain metadata-only until a deployment provider is configured.
# v3.3 Enterprise Identity, SSO & Provisioning Hub
# Enable only after Firebase Authentication / Identity Platform providers are configured and independently approved in OPSIQO.
OPSIQO_ENABLE_ENTERPRISE_SSO=false
# Exact public hosts allowed for OIDC discovery or SAML metadata validation, comma-separated. Required in production when enterprise SSO is enabled.
# Examples depend on the organization IdP tenancy/configuration; do not copy example tenant hosts blindly.
OPSIQO_IDENTITY_HOSTS=
# Optional public provider discovery on the sign-in page. Keep false unless the organization deliberately exposes active provider names.
OPSIQO_PUBLIC_SSO_DISCOVERY=false
# Optional default organization context used by the sign-in page when the deployment is single-tenant.
NEXT_PUBLIC_OPSIQO_DEFAULT_ORG_ID=


# v3.4 HCM Security Operations / Zero-Trust
OPSIQO_ENABLE_SECURITY_OPERATIONS=false
# Dedicated HMAC secret for external SIEM/SOC event ingress. Use >=32 random characters.
OPSIQO_SECURITY_EVENT_INGEST_SECRET=
OPSIQO_SECURITY_EVENT_INGEST_ORG_ID=
# Multi-tenant alternative: JSON object mapping orgId to secret. Prefer deployment secret manager injection.
OPSIQO_SECURITY_EVENT_INGEST_SECRETS_JSON=
# Exact approved public SIEM/SOC hosts when external exchange is enabled.
OPSIQO_SECURITY_SIEM_HOSTS=


# v3.5 Platform Reliability, Software Supply Chain, SRE & Disaster Recovery
# Production promotion requires this control plane to be explicitly enabled.
OPSIQO_ENABLE_PLATFORM_RELIABILITY=false
# Declares where independently governed backup/recovery evidence is obtained. This setting is not proof by itself.
# Allowed: firebase_pitr | external_backup | governed_manual
OPSIQO_BACKUP_EVIDENCE_MODE=governed_manual
# Human-readable identifier for the approved monitoring/evidence source (for example: cloud-monitoring-prod).
OPSIQO_PLATFORM_MONITORING_SOURCE=


# v3.6.1 Production Evidence Closure & Cloud DR Execution
# Traceable evidence references are required in production. They do not prove the underlying controls by themselves.
OPSIQO_PRODUCTION_EVIDENCE_REF=
OPSIQO_CLOUD_DR_EVIDENCE_REF=
OPSIQO_DR_EXERCISE_EVIDENCE_REF=
# Cloud DR policy used by the evidence collector.
OPSIQO_CLOUD_DR_REQUIRE_PITR=true
OPSIQO_CLOUD_DR_REQUIRE_SCHEDULED_BACKUP=true
OPSIQO_CLOUD_DR_MAX_BACKUP_AGE_HOURS=36
# CI-only controlled restore exercise. Use a non-sensitive Firestore document whose canonical JSON SHA-256 is stored as a protected CI secret.
OPSIQO_DR_SENTINEL_DOCUMENT_PATH=
OPSIQO_DR_SENTINEL_EXPECTED_SHA256=
OPSIQO_DR_TARGET_RTO_MINUTES=120
OPSIQO_DR_TARGET_RPO_MINUTES=1440

# OPSIQO local emulator development
# The standard `npm run dev:backend` + `npm run dev:frontend` commands inject
# these settings in child processes without writing secrets to .env.local.
# Set this only when intentionally connecting the browser SDK to local emulators.
NEXT_PUBLIC_OPSIQO_USE_FIREBASE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# Optional local Firebase demo project id used by the dev wrappers.
OPSIQO_LOCAL_FIREBASE_PROJECT_ID=demo-opsiqo-local
# Optional bootstrap identity override for an empty emulator data set.
OPSIQO_LOCAL_ADMIN_EMAIL=admin@opsiqo.local
# Optional comma-separated development-only hostnames/IPs in addition to the
# machine's detected local IPv4 interfaces.
OPSIQO_ALLOWED_DEV_ORIGINS=

# Release identity
OPSIQO_PRODUCT_RELEASE=8.5-v7.9.1
OPSIQO_RELEASE_COMMIT=local-uncommitted
NEXT_PUBLIC_OPSIQO_PRODUCT_RELEASE=8.5-v7.9.1
NEXT_PUBLIC_OPSIQO_CERTIFICATION_BASELINE=3.6.1
NEXT_PUBLIC_OPSIQO_RELEASE_COMMIT=local-uncommitted
