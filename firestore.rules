rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /prehireAccessIndex/{docId} { allow read, write: if false; }
    function signedIn() { return request.auth != null; }
    function membership(orgId) { return get(/databases/$(database)/documents/organizations/$(orgId)/memberships/$(request.auth.uid)); }
    function activeMember(orgId) { return signedIn() && membership(orgId).data.status == 'active'; }
    function role(orgId) { return membership(orgId).data.role; }
    function isHR(orgId) { return activeMember(orgId) && role(orgId) in ['super_admin', 'org_admin', 'hr_admin', 'hr_partner']; }
    function isAdmin(orgId) { return activeMember(orgId) && role(orgId) in ['super_admin', 'org_admin', 'hr_admin']; }
    function isManager(orgId) { return activeMember(orgId) && role(orgId) in ['super_admin', 'org_admin', 'hr_admin', 'hr_partner', 'manager']; }

    match /organizations/{orgId} {
      allow read: if activeMember(orgId);
      allow write: if isAdmin(orgId);

      match /memberships/{uid} {
        allow read: if activeMember(orgId) && (request.auth.uid == uid || isHR(orgId));
        allow write: if false;
      }
      match /invitations/{docId} { allow read: if isHR(orgId); allow write: if false; }
      match /invitationTokenIndex/{docId} { allow read, write: if false; }
      match /invitationEmailIndex/{docId} { allow read, write: if false; }
      match /employeeNumberIndex/{docId} { allow read, write: if false; }
      match /workEmailIndex/{docId} { allow read, write: if false; }
      match /secondaryAssignmentIndex/{docId} { allow read, write: if false; }
      match /secondaryAssignmentPlanIndex/{docId} { allow read, write: if false; }
      match /positionOccupancy/{docId} { allow read: if activeMember(orgId); allow write: if false; }

      match /orgUnits/{docId} { allow read: if activeMember(orgId); allow write: if isAdmin(orgId); }
      match /positions/{docId} { allow read: if activeMember(orgId); allow write: if isHR(orgId); }
      match /workers/{docId} { allow read: if isHR(orgId) || (activeMember(orgId) && membership(orgId).data.workerId == docId); allow write: if isHR(orgId); }
      match /workerDirectory/{docId} { allow read: if activeMember(orgId); allow write: if false; }
      match /people/{docId} {
        allow read: if isHR(orgId) || (activeMember(orgId) && resource.data.authUid == request.auth.uid);
        allow create, delete: if isHR(orgId);
        allow update: if isHR(orgId) || (
          activeMember(orgId)
          && resource.data.authUid == request.auth.uid
          && request.resource.data.authUid == resource.data.authUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['preferredName', 'personalEmail', 'phone', 'updatedAt'])
        );
      }
      match /employments/{docId} {
        allow read: if isHR(orgId) || (activeMember(orgId) && resource.data.workerId == membership(orgId).data.workerId);
        allow write: if isHR(orgId);
      }
      match /assignments/{docId} {
        allow read: if isHR(orgId) || (
          activeMember(orgId) && (
            resource.data.workerId == membership(orgId).data.workerId
            || resource.data.managerWorkerId == membership(orgId).data.workerId
          )
        );
        allow write: if isHR(orgId);
      }
      match /employeeChanges/{docId} { allow read: if isHR(orgId); allow write: if false; }
      match /secondaryAssignmentPlans/{docId} { allow read: if isHR(orgId); allow write: if false; }
      // Workflow internals are server-owned. Governed APIs enforce organization and RBAC scope.
      match /workflowDefinitions/{docId} { allow read, write: if false; }
      match /workflowRuns/{docId} { allow read, write: if false; }
      match /workflowStepRuns/{docId} { allow read, write: if false; }
      match /workflowEscalations/{docId} { allow read: if isHR(orgId); allow write: if false; }
      match /workflowDispatches/{docId} { allow read: if isAdmin(orgId); allow write: if false; }
      match /domainEvents/{docId} { allow read: if isAdmin(orgId); allow write: if false; }
      match /automationRuns/{docId} { allow read: if isAdmin(orgId); allow write: if false; }
      match /settings/{docId} { allow read: if isAdmin(orgId); allow write: if false; }
      match /notifications/{docId} {
        allow read: if activeMember(orgId) && (
          isAdmin(orgId)
          || resource.data.targetUid == request.auth.uid
          || resource.data.targetRole == role(orgId)
        );
        allow write: if false;
      }
      match /requisitions/{docId} { allow read: if isHR(orgId) || (isManager(orgId) && resource.data.hiringManagerWorkerId == membership(orgId).data.workerId); allow write: if false; }
      match /candidates/{docId} { allow read: if isHR(orgId); allow write: if false; }
      match /applications/{docId} { allow read: if isHR(orgId); allow write: if false; }
      match /interviews/{docId} { allow read: if isHR(orgId); allow write: if false; }
      match /scorecards/{docId} { allow read: if isHR(orgId); allow write: if false; }
      match /offers/{docId} { allow read: if isHR(orgId); allow write: if false; }
      match /onboardingCases/{docId} { allow read: if isHR(orgId); allow write: if false; }
      match /onboardingTasks/{docId} { allow read: if isHR(orgId); allow write: if false; }
      match /onboardingPolicies/{docId} { allow read: if isHR(orgId); allow write: if false; }
      match /prehireDocuments/{docId} { allow read: if isHR(orgId); allow write: if false; }
      match /policyAcknowledgements/{docId} { allow read: if isHR(orgId); allow write: if false; }
      match /prehireOfferIndex/{docId} { allow read, write: if false; }
      match /candidateEmailIndex/{docId} { allow read, write: if false; }
      match /candidateApplicationIndex/{docId} { allow read, write: if false; }
      match /hireConversionIndex/{docId} { allow read, write: if false; }
      match /counters/{docId} { allow read, write: if false; }
      match /employeeDocuments/{docId} { allow read, write: if false; }
      match /employeeDocumentVersions/{docId} { allow read, write: if false; }
      match /policies/{docId} { allow read, write: if false; }
      match /policyVersions/{docId} { allow read, write: if false; }
      match /retentionRules/{docId} { allow read, write: if false; }
      match /complianceRequirements/{docId} { allow read, write: if false; }
      match /prehireEvidencePromotion/{docId} { allow read, write: if false; }
      match /leaveTypes/{docId} { allow read, write: if false; }
      match /leaveBalances/{docId} { allow read, write: if false; }
      match /leaveRequests/{docId} { allow read, write: if false; }
      match /holidayCalendars/{docId} { allow read, write: if false; }
      match /holidays/{docId} { allow read, write: if false; }
      match /timePolicies/{docId} { allow read, write: if false; }
      match /workerTimeProfiles/{docId} { allow read, write: if false; }
      match /timeEntries/{docId} { allow read, write: if false; }
      match /timeExceptions/{docId} { allow read, write: if false; }
      match /timesheets/{docId} { allow read, write: if false; }
      match /payrollExports/{docId} { allow read, write: if false; }
      match /separationCases/{docId} { allow read, write: if false; }
      match /separationTasks/{docId} { allow read, write: if false; }
      match /separationAssets/{docId} { allow read, write: if false; }
      match /exitInterviews/{docId} { allow read, write: if false; }
      match /notificationDedupe/{docId} { allow read, write: if false; }
      match /notificationTemplates/{docId} { allow read, write: if false; }
      match /lifecycleDiagnosticRuns/{docId} { allow read, write: if false; }
      match /replacementRequisitionIndex/{docId} { allow read, write: if false; }
      match /performanceCycles/{docId} { allow read, write: if false; }
      match /performanceGoals/{docId} { allow read, write: if false; }
      match /competencies/{docId} { allow read, write: if false; }
      match /competencyExpectations/{docId} { allow read, write: if false; }
      match /performanceReviews/{docId} { allow read, write: if false; }
      match /performanceCheckIns/{docId} { allow read, write: if false; }
      match /feedbackRequests/{docId} { allow read, write: if false; }
      match /feedbackResponses/{docId} { allow read, write: if false; }
      match /developmentPlans/{docId} { allow read, write: if false; }
      match /performanceImprovementPlans/{docId} { allow read, write: if false; }
      match /skills/{docId} { allow read, write: if false; }
      match /skillCodeIndex/{docId} { allow read, write: if false; }
      match /positionSkillRequirements/{docId} { allow read, write: if false; }
      match /workerSkills/{docId} { allow read, write: if false; }
      match /courses/{docId} { allow read, write: if false; }
      match /courseCodeIndex/{docId} { allow read, write: if false; }
      match /learningPaths/{docId} { allow read, write: if false; }
      match /learningPathCodeIndex/{docId} { allow read, write: if false; }
      match /learningAssignments/{docId} { allow read, write: if false; }
      match /learningCertificates/{docId} { allow read, write: if false; }
      match /careerProfiles/{docId} { allow read, write: if false; }
      match /careerReadinessPolicies/{docId} { allow read, write: if false; }
      match /internalMobilityInterests/{docId} { allow read, write: if false; }
      match /criticalPositions/{docId} { allow read, write: if false; }
      match /successorNominations/{docId} { allow read, write: if false; }
      match /talentAssessments/{docId} { allow read, write: if false; }
      match /jobFamilies/{docId} { allow read, write: if false; }
      match /jobFamilyCodeIndex/{docId} { allow read, write: if false; }
      match /jobLevels/{docId} { allow read, write: if false; }
      match /jobLevelCodeIndex/{docId} { allow read, write: if false; }
      match /salaryBands/{docId} { allow read, write: if false; }
      match /salaryBandCodeIndex/{docId} { allow read, write: if false; }
      match /positionCompensationProfiles/{docId} { allow read, write: if false; }
      match /workerCompensationRecords/{docId} { allow read, write: if false; }
      match /workerCompensationCurrent/{docId} { allow read, write: if false; }
      match /marketBenchmarks/{docId} { allow read, write: if false; }
      match /compensationCycles/{docId} { allow read, write: if false; }
