      match /platformBackupPolicies/{docId} { allow read, write: if false; }
      match /platformBackupPolicyCodeIndex/{docId} { allow read, write: if false; }
      match /platformBackupEvidence/{docId} { allow read, write: if false; }
      match /platformDrPlans/{docId} { allow read, write: if false; }
      match /platformDrPlanCodeIndex/{docId} { allow read, write: if false; }
      match /platformDrExercises/{docId} { allow read, write: if false; }
      match /platformConfigBaselines/{docId} { allow read, write: if false; }
      match /platformConfigBaselineCodeIndex/{docId} { allow read, write: if false; }
      match /platformDriftSnapshots/{docId} { allow read, write: if false; }
      match /platformIncidents/{docId} { allow read, write: if false; }
      match /platformIncidentCodeIndex/{docId} { allow read, write: if false; }
      match /platformServiceObjectives/{docId} { allow read, write: if false; }
      match /platformServiceObjectiveCodeIndex/{docId} { allow read, write: if false; }
      match /platformReliabilitySnapshots/{docId} { allow read, write: if false; }

      match /approvals/{docId} { allow read: if activeMember(orgId); allow write: if false; }
      match /auditLogs/{docId} { allow read: if isHR(orgId); allow write: if false; }
    }
  }
}
