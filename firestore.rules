      match /totalRewardsInputs/{docId} { allow read, write: if false; }
      match /payEquityJobClasses/{docId} { allow read, write: if false; }
      match /payTransparencyPolicies/{docId} { allow read, write: if false; }
      match /requisitionCompensationDisclosures/{docId} { allow read, write: if false; }
      match /employeeRelationsCases/{docId} { allow read, write: if false; }
      match /employeeRelationsCaseTeam/{docId} { allow read, write: if false; }
      match /employeeRelationsParticipants/{docId} { allow read, write: if false; }
      match /employeeRelationsEvidence/{docId} { allow read, write: if false; }
      match /employeeRelationsInterviews/{docId} { allow read, write: if false; }
      match /employeeRelationsFindings/{docId} { allow read, write: if false; }
      match /employeeRelationsActions/{docId} { allow read, write: if false; }
      match /employeeAccommodationPlans/{docId} { allow read, write: if false; }
      match /safetyIncidents/{docId} { allow read, write: if false; }
