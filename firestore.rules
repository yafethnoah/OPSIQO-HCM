      match /safetyCommitteeProfiles/{docId} { allow read, write: if false; }
      match /safetyCommitteeMeetings/{docId} { allow read, write: if false; }
      match /safetyCommitteeRecommendations/{docId} { allow read, write: if false; }
      match /employeeSurveys/{docId} { allow read, write: if false; }
      match /surveyResponses/{docId} { allow read, write: if false; }
      match /surveyParticipationIndex/{docId} { allow read, write: if false; }
      match /serviceCatalogItems/{docId} { allow read, write: if false; }
      match /hrServiceTickets/{docId} { allow read, write: if false; }
      match /serviceTicketComments/{docId} { allow read, write: if false; }
      match /serviceSatisfaction/{docId} { allow read, write: if false; }
      match /knowledgeArticles/{docId} { allow read, write: if false; }
      match /recognitions/{docId} { allow read, write: if false; }
      match /employeeIdeas/{docId} { allow read, write: if false; }
      match /workforcePlans/{docId} { allow read, write: if false; }
      match /workforcePlanCodeIndex/{docId} { allow read, write: if false; }
      match /workforceSnapshots/{docId} { allow read, write: if false; }
      match /workforceScenarios/{docId} { allow read, write: if false; }
      match /workforceDemand/{docId} { allow read, write: if false; }
      match /analyticsMetrics/{docId} { allow read, write: if false; }
      match /analyticsMetricCodeIndex/{docId} { allow read, write: if false; }
      match /analyticsSnapshots/{docId} { allow read, write: if false; }
      match /analyticsForecastModels/{docId} { allow read, write: if false; }
      match /analyticsForecastModelCodeIndex/{docId} { allow read, write: if false; }
      match /analyticsForecastRuns/{docId} { allow read, write: if false; }

      // H51.1 Agent System of Record: governed server APIs are the only client-facing boundary.
      match /aiAgentDefinitions/{agentId} {
        allow read, write: if false;
        match /versions/{versionId} { allow read, write: if false; }
        match /simulations/{simulationId} { allow read, write: if false; }
        match /executions/{executionId} { allow read, write: if false; }
      }
      match /aiPromptTemplates/{docId} { allow read, write: if false; }
      match /aiModelProfiles/{docId} { allow read, write: if false; }
      match /aiRuns/{docId} { allow read, write: if false; }
      match /aiActionPlans/{docId} { allow read, write: if false; }
      match /aiEvalRuns/{docId} { allow read, write: if false; }
      match /contractImportDrafts/{docId} { allow read, write: if false; }
      match /contractRecords/{docId} { allow read, write: if false; }
      match /contractModuleSyncProposals/{docId} { allow read, write: if false; }
      match /workerContractProfiles/{docId} { allow read, write: if false; }
      match /diagnosticFrameworks/{docId} { allow read, write: if false; }
      match /diagnosticFrameworkCodeIndex/{docId} { allow read, write: if false; }
      match /diagnosticControls/{docId} { allow read, write: if false; }
