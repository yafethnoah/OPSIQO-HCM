# Public mobile runtime configuration only. Never place service-account credentials or private keys here.
# UAT example:
EXPO_PUBLIC_OPSIQO_API_BASE_URL=https://uat.opsiqo.ca
EXPO_PUBLIC_OPSIQO_ENVIRONMENT=uat
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_EAS_PROJECT_ID=

# EAS mapping:
# development profile -> EAS development environment
# uat profile         -> EAS preview environment
# production profile  -> EAS production environment
# Configure Firebase public client values in the matching EAS environment instead of committing them.
